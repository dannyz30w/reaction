<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Bronx Science Reactions Journal</title>

  <!-- Google fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg: #faf7f4;
      --card-bg: #111111;
      --muted: #8f8b88;
      --accent1: #f07d7d; /* coral-ish */
      --accent2: #7fc8d9; /* aqua-ish */
      --max-width: 1200px;
    }
    *{box-sizing:border-box}
    html,body{height:100%;margin:0;font-family: Lora, serif;background:var(--bg);color:#222}
    a{color:inherit}
    .wrap{max-width:var(--max-width);margin:30px auto;padding:0 22px}

    /* Nav */
    header.nav{
      display:flex;align-items:center;justify-content:space-between;
      gap:18px;margin-bottom:22px;
    }
    .brand{font-family:Playfair Display, serif;font-size:20px;font-weight:700;color:#222}
    nav ul{display:flex;gap:18px;list-style:none;padding:0;margin:0}
    nav a{color: #333;text-decoration:none;font-weight:600}
    /* Hero */
    .hero{
      background:linear-gradient(0deg, rgba(0,0,0,0.25), rgba(0,0,0,0.15)),
        url('assets/cover.jpg') center/cover no-repeat;
      border-radius:14px;padding:48px 36px;color:white;min-height:280px;display:flex;flex-direction:column;justify-content:flex-end;
      box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    }
    .hero .siteline{color:rgba(255,255,255,0.85);font-weight:600;margin-bottom:6px}
    .hero h1{font-family:Playfair Display, serif;font-size:44px;margin:0 0 6px}
    .hero p.lead{margin:0;color:rgba(255,255,255,0.92);font-size:16px}

    /* Quote row */
    .quote-row{display:flex;align-items:center;gap:20px;margin:28px 0}
    .quote-big{flex:1;font-family:Playfair Display, serif;font-size:28px;color:#333}
    .quick-blurb{width:300px;color:var(--muted);font-size:15px}

    /* Main columns */
    .columns{display:grid;grid-template-columns:1fr 320px;gap:24px}
    /* Editorial list */
    .editorial{background:white;border-radius:12px;padding:20px;box-shadow: 0 8px 18px rgba(15,15,15,0.06)}
    .editorial h2{margin-top:0;font-family:Playfair Display, serif}
    .article-list{display:flex;flex-direction:column;gap:14px;margin-top:12px}
    .article{
      display:flex;gap:14px;align-items:flex-start;
      border-left:3px solid rgba(0,0,0,0.06);padding-left:12px;
    }
    .article .thumb{width:72px;height:72px;border-radius:6px;background:#eee;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--muted)}
    .article .meta{font-size:14px}
    .article .meta .title{font-weight:700;margin-bottom:6px}
    .more-btn{display:inline-block;margin-top:12px;padding:8px 12px;border-radius:6px;background:#111;color:white;text-decoration:none;font-weight:700}

    /* Right column boxes */
    .panel{background:white;border-radius:12px;padding:18px;box-shadow: 0 8px 18px rgba(15,15,15,0.06)}
    .panel h3{margin-top:0;font-family:Playfair Display, serif}
    .panel p{margin:8px 0;color:var(--muted)}

    /* Staff grid */
    .staff-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-top:28px}
    .staff-card{
      background:var(--card-bg);color:white;border-radius:14px;padding:26px;min-height:120px;
      display:flex;flex-direction:column;justify-content:center;align-items:center;box-shadow: 0 8px 30px rgba(0,0,0,0.25)
    }
    .staff-card .role{font-family:Playfair Display, serif;font-weight:700;font-size:20px;
      /* fancy two-tone text */
      background: linear-gradient(90deg,var(--accent1),var(--accent2));
      -webkit-background-clip:text;background-clip:text;color:transparent;
      margin-bottom:10px;
    }
    .staff-card ul{list-style:none;padding:0;margin:0;text-align:center;color:#ddd}
    .staff-card li{margin:6px 0}

    /* Footer */
    footer{margin-top:36px;color:var(--muted);font-size:13px;text-align:center;padding-bottom:40px}

    /* Responsive */
    @media (max-width:880px){
      .columns{grid-template-columns:1fr}
      .quote-big{font-size:20px}
      .hero{min-height:220px;padding:28px}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="nav">
      <div class="brand">Bronx Science Reactions</div>
      <nav>
        <ul>
          <li><a href="#home">Home</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#staff">Staff</a></li>
          <li><a href="#past">Past Editions</a></li>
        </ul>
      </nav>
    </header>

    <!-- HERO -->
    <section class="hero" id="home" role="banner" aria-label="Recent cover">
      <div class="siteline">The dedicated students behind the Bronx Science Reactions Journal</div>
      <h1>Reactions — combining science, art, and innovation</h1>
      <p class="lead">A student-run science journal from Bronx Science. See our latest issue below.</p>
    </section>

    <!-- Quote + blurb -->
    <div class="quote-row" style="margin-top:18px">
      <div class="quote-big">“For every action, there is a reaction.” — Isaac Newton</div>
      <aside class="quick-blurb">
        <strong>Explore how Bronx Science...</strong>
        <p style="margin-top:8px;color:var(--muted)">Selected editorials, activities, and PDFs from previous editions listed to the right. Click a cover to open the full issue.</p>
      </aside>
    </div>

    <!-- Main columns -->
    <div class="columns">
      <main>
        <section class="editorial">
          <h2>Editorial — Most recent articles</h2>
          <div class="article-list" id="articleList">
            <!-- Example article entries; replace with real content -->
            <article class="article">
              <div class="thumb">Art 1</div>
              <div class="meta">
                <div class="title">The Chemistry of Colors</div>
                <div class="excerpt">A look at molecular pigments and how they produce natural colors in flowers.</div>
              </div>
            </article>

            <article class="article">
              <div class="thumb">Art 2</div>
              <div class="meta">
                <div class="title">Physics and Everyday Motion</div>
                <div class="excerpt">How Newtonian mechanics explain motions you see at school and home.</div>
              </div>
            </article>
          </div>

          <a class="more-btn" href="#past">More</a>
        </section>

        <!-- Staff grid -->
        <section id="staff" style="margin-top:22px">
          <h2 style="font-family:Playfair Display, serif">Staff</h2>
          <div class="staff-grid" id="staffGrid">
            <!-- Cards generated by JS below. Edit the data in the script to update names -->
          </div>
        </section>
      </main>

      <!-- Right column (selected articles + activities + past issues) -->
      <aside>
        <div class="panel">
          <h3>Selected Articles</h3>
          <p>Thought-provoking pieces and student favorites. <a href="#past">View past issues</a> for full PDFs.</p>
        </div>

        <div class="panel" style="margin-top:16px">
          <h3>Activities</h3>
          <p>Visuals and interactive content from previous issues can be shown as screenshots or embedded pages. You can also link to PDFs below.</p>
        </div>

        <div class="panel" style="margin-top:16px">
          <h3>Past Editions (PDFs)</h3>
          <p>Click a link to open the full issue (PDF) in a new tab:</p>
          <ul id="pastList" style="margin:8px 0 0 16px;padding:0;color:var(--muted)"></ul>

          <hr style="margin:12px 0;border:none;border-top:1px solid #eee">
          <small style="color:var(--muted)">If you need to host a new PDF, see the instructions under <strong>How to attach PDFs</strong> below.</small>
        </div>
      </aside>
    </div>

    <footer>
      &copy; <span id="year"></span> Bronx Science Reactions — Student journal
    </footer>
  </div>

  <script>
    // ====== CONFIG: edit these to change staff and past PDF links ======
    const staffData = [
      { role: "Editor-in-Chief", names:["Adeline Nurenie"] },
      { role: "Chemistry & Nature", names:["Odessa Muñoz","Amanda Ro","Sabir Sobur"] },
      { role: "Physics & Math", names:["Tara Plotnik-Friedman","Sam Land","Linwang Li"] },
      { role: "Graphic Designers", names:["Johanna Cao","Nikell Adu","Olivia Lee"] },
      { role: "Programming", names:["Linwang Li","Danny Zheng"] }
    ];

    const pastIssues = [
      { title:"Issue - Spring 2025 (Cover)", file:"pdfs/issue-spring-2025.pdf" },
      { title:"Issue - Fall 2024 (Cover)", file:"pdfs/issue-fall-2024.pdf" }
      // add more: { title: "...", file: "pdfs/..." }
    ];
    // ================================================================

    // Populate staff grid
    const staffGrid = document.getElementById('staffGrid');
    for(const s of staffData){
      const card = document.createElement('div');
      card.className = 'staff-card';
      const role = document.createElement('div');
      role.className = 'role';
      role.textContent = s.role;
      card.appendChild(role);
      const ul = document.createElement('ul');
      for(const n of s.names){
        const li = document.createElement('li');
        li.textContent = n;
        ul.appendChild(li);
      }
      card.appendChild(ul);
      staffGrid.appendChild(card);
    }

    // Populate past PDF list
    const pastList = document.getElementById('pastList');
    for(const p of pastIssues){
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = p.file; // relative link to PDF
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = p.title;
      li.appendChild(a);
      pastList.appendChild(li);
    }

    // year
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
